[Unit]
Description=earshot daemon (Slack-resident agent)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/earshot
EnvironmentFile=-%h/earshot/.env
Environment=EARSHOT_DB=%h/earshot-data/earshot.db
Environment=EARSHOT_POLICY=%h/earshot/policy.yaml
Environment=PATH=%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.bun/bin/bun run src/main.ts
Restart=always
RestartSec=5
TimeoutStopSec=180
KillSignal=SIGTERM

[Install]
WantedBy=default.target
